#!/bin/bash
# Script to launch the backup tool

# Source the standardized environment configuration
SCRIPT_DIR=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
source "$SCRIPT_DIR/qp2_env.sh"

# Execute the python module. "$@" passes all command-line arguments to the Python script.
$MYPYTHON -m qp2.backup.main "$@"
